{
  "compilerOptions": {
    "target": "ES2015",
    "module": "ES2015",
    "moduleResolution": "node",
    "strict": false,
    "skipLibCheck": true,
    "noEmit": true,
    "experimentalDecorators": true,
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "types": [
      "../types/engine/cc",
      "../types/engine/cc.custom-macro",
      "../types/engine/jsb",
      "../types/engine/cc.env"
    ]
  },
  "include": ["../assets/**/*.ts"],
  "exclude": ["../assets/unused/**"]
}
