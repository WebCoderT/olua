# 本地开发环境（npm run dev 时生效）
# 服务端启动方式见根目录 README 的「运行方式」：cd server && npm run dev（默认 3100 端口）
VITE_API_BASE_URL=http://localhost:3100/api
# 页面被手机 / 另一台电脑用局域网 IP 打开时，把上面地址的主机换成页面自己的主机
# （端口与路径保持不变）—— 局域网真机调试因此不用改配置。详见 admin/.env.example
VITE_API_FOLLOW_PAGE_HOST=true
VITE_API_TIMEOUT=15000
VITE_APP_TITLE=olua 管理端
