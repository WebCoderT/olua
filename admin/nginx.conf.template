# ==============================================================================
#  入口 nginx（唯一对外 :80）—— 官网 / 管理端 / 游戏三站按 server_name 分流
#
#  **这是 envsubst 模板，不是最终配置**：nginx 镜像启动时由 docker-entrypoint.d 里的
#  20-envsubst-on-templates.sh 把 `${OLUA_*}` 换成容器环境变量，写到 conf.d/default.conf。
#  所以**换域名不用改代码也不用重建镜像**，改 docker-compose 的环境变量（或服务器上的
#  `.env`）再 `docker compose up -d admin` 即可。三站各一个变量：
#      OLUA_SITE_DOMAINS   官网站（空格分隔多个，含 www）
#      OLUA_ADMIN_DOMAIN   管理端（default_server 保底：IP 等未匹配访问也进管理端）
#      OLUA_GAME_DOMAIN    游戏站
#  模板里其余的 `$host` / `$uri` 这类 nginx 变量**不会**被误替换 —— envsubst 只替换
#  容器里真实存在的环境变量，nginx 运行时变量不在其中。
#
#  为什么把三个站都放在管理端容器这唯一一个 :80 上：对外只开一个端口最省事，靠
#  server_name 分流；官网与游戏反代到对应容器（server_name 已写进 Host 头，容器内的
#  nginx 配置不用感知外部域名），管理端静态文件由本容器自己出。
#
#  两处与 docker-compose.yml 耦合，改任何一边都要两边一起改
#  （tools/audit-deploy.cjs 会替你把它们对上）：
#    1. `server` / `game` / `website` 是 compose 里的服务名（用变量 + Docker 内置 DNS 解析，
#       容器未就绪时不会让 nginx 起不来）
#    2. `/api/` 要和服务端的 API_PREFIX 一致
# ==============================================================================

# 游戏域名整站反代用的 upgrade 映射（WebSocket 必须原样把 Upgrade/Connection 传下去，
# 少一个头实时通道就是「能登录、连不上」）
map $http_upgrade $olua_conn_upgrade {
  default upgrade;
  ''      close;
}

# ==============================================================================
#  官网站：yimw.cn / www.yimw.cn → website 容器（纯静态，整站反代）
# ==============================================================================
server {
  listen 80;
  server_name ${OLUA_SITE_DOMAINS};

  resolver 127.0.0.11 valid=10s ipv6=off;
  set $olua_site http://website:80;

  location / {
    proxy_pass $olua_site;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
  }
}

# ==============================================================================
#  管理端：admin.yimw.cn（default_server 保底 = 未匹配域名的访问（如直接用 IP）进管理端）
#
#  **`_` 不是通配符**：nginx 的兜底靠 default_server 标记（:80 的第一个 server 块
#  是隐式默认 —— 上一个版本只有管理端一个块所以碰巧对，三站分流后必须显式声明，
#  否则 IP 访问会落到排第一的官网站上拿到 404）。
#
#  为什么要把 /api 反代过去：管理端与接口**同源**之后，浏览器根本不发跨域请求，
#  服务端就不必配 CORS_ORIGINS —— 少一处会配错、而且配错了很难被发现的东西。
# ==============================================================================
server {
  listen 80 default_server;
  server_name ${OLUA_ADMIN_DOMAIN} _;

  root /usr/share/nginx/html;
  index index.html;

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;
  gzip_min_length 1024;

  # 带内容哈希的静态资源可以长缓存
  location /assets/ {
    expires 30d;
    add_header Cache-Control "public, immutable";
  }

  # 单页应用：/accounts/xxx 这类前端路由直接刷新时也要能落到 index.html
  location / {
    try_files $uri $uri/ /index.html;
  }

  # index.html 不缓存：否则发版后浏览器还在用旧页面（它引用的资源已经不存在了）
  location = /index.html {
    add_header Cache-Control "no-store";
  }

  # 客户端素材（装备对齐工作台用）：反代到 game 容器
  #
  # 为什么不直接让浏览器去 `http://host:8080/resources/...`：那是跨域，
  # 图片能显示，但工作台要把 PNG 画进 canvas 量不透明轮廓（`getImageData`），
  # 跨域图会把 canvas 标记为 tainted 并直接抛错。走同源反代就没有这回事。
  # 用变量 + Docker 内置 DNS 的理由同下面的 /api/（game 未就绪时不能让 nginx 起不来）。
  location /game-resources/ {
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $olua_game http://game:80;
    rewrite ^/game-resources/(.*)$ /resources/$1 break;
    proxy_pass $olua_game;
    proxy_set_header Host $host;
  }

  location /api/ {
    # 用「变量 + Docker 内置 DNS」而不是把上游写成字面量：写死的话，server 容器还没就绪时
    # nginx 会因为 `host not found in upstream` **直接启动失败**（depends_on 只保证启动顺序，
    # 不保证名字已经可解析）。用变量后解析推迟到请求时，起停顺序就不敏感了。
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $olua_api http://server:3100;
    proxy_pass $olua_api;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    # 服务端要能看到真实来源 IP（登录限流按 IP 计数），所以这两个头必须有，
    # 且服务端要开 TRUST_PROXY（见 docker-compose.yml）
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}

# ==============================================================================
#  游戏站：${OLUA_GAME_DOMAIN} → game 容器（:80 上的整站反代）
#
#  为什么放在这里而不是让游戏独占一个端口：对外只开 80 最省事，靠 `server_name` 分流，
#  和 :8080 是**同一份产物**（game 容器没变），两条入口并存：
#      http://${OLUA_GAME_DOMAIN}/   → 本段 → game:80
#      http://<IP>:8080/             → game:80（直连，调试用）
#
#  注意：游戏容器的 nginx 自己负责 /api/ 与 /api/realtime（含 WS upgrade），所以这里
#  **整站透传**即可，不要在本段重复写 /api 反代 —— 两处各写一份必然会漂移。
# ==============================================================================
server {
  listen 80;
  server_name ${OLUA_GAME_DOMAIN};

  resolver 127.0.0.11 valid=10s ipv6=off;
  set $olua_game_site http://game:80;

  location / {
    proxy_pass $olua_game_site;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # 实时通道走 /api/realtime（WebSocket）：这两行不能少
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $olua_conn_upgrade;
    # 2.3G 素材都是静态文件，别让默认的 60s 读超时在中途掐断大图
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;
  }
}
