# 管理端配置模板（复制为 .env.development / .env.production 后按环境填写）

# 服务端接口根地址（**唯一来源**：代码里不允许再出现任何后端地址字面量）
# 本地开发：服务端默认跑在 3100，接口前缀 /api
VITE_API_BASE_URL=http://localhost:3100/api

# 是否让接口地址跟随「当前页面的主机」（true / false，缺省 false）
# 打开后：若上面是绝对地址，则把它的主机换成页面自己的主机，端口与路径不变 ——
#   手机 / 另一台电脑用局域网 IP 打开管理端时，请求自动打到那台电脑的服务端，
#   不用改这一行（每个人 IP 不同，写死反而谁都不对）。
# 开发环境（.env.development）默认打开；生产走同源 /api 或固定域名，保持关闭。
VITE_API_FOLLOW_PAGE_HOST=false

# 请求超时（毫秒）
VITE_API_TIMEOUT=15000

# 页面标题
VITE_APP_TITLE=olua 管理端
