
#///////////////////////////
# Cocos Creator 3D Project（客户端在 client/，它才是 Cocos 工程根）
#///////////////////////////
client/library/
client/temp/
client/local/
client/build/
client/profiles/
client/native
#//////////////////////////
# NPM
#//////////////////////////
node_modules/

#//////////////////////////
# VSCode
#//////////////////////////
.vscode/

#//////////////////////////
# WebStorm
#//////////////////////////
.idea/

# 客户端素材（体积大、不进版本库；删前必备份）
client/assets/resources/

# 设计稿（UI 重排的输入：登录 / 选角 / 主界面截图；体积大、属本机设计资料，不进版本库）
design/

# AI 生图工具的默认输出目录（成品图标人工挑选拷进 resources/ 后，中间底图不留仓库）
generated-images/

#//////////////////////////
# macOS 噪声（Finder 元数据 / AppleDouble，不该进版本库）
#//////////////////////////
.DS_Store
._*

#//////////////////////////
# .workbuddy：只提交「记忆」与「技能」，其余（临时备份等）仍忽略
#   - memory/ 项目记忆：长期约定 + 逐日工作日志，跟随版本库走
#   - skills/ 项目技能：从本项目沉淀的做法与踩坑，跟随版本库走
#   - backup/ 等其余内容是本机临时产物，不进版本库
#//////////////////////////
.workbuddy/*
!.workbuddy/memory
!.workbuddy/skills
.backup

#//////////////////////////
# 部署密钥（**绝不进版本库**：deploy.env 是唯一放服务器 IP / 密钥 / 邀请码的地方，
# 仓库只提交模板 deploy.env.example；.pem 是服务器登录私钥）
#//////////////////////////
deploy.env
*.pem
admin/tsconfig.tsbuildinfo
