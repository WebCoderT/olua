
#///////////////////////////
# Cocos Creator 3D Project（客户端在 client/，它才是 Cocos 工程根）
#///////////////////////////
client/library/
client/temp/
client/local/
client/build/
client/profiles/
client/native
#//////////////////////////
# NPM
#//////////////////////////
node_modules/

#//////////////////////////
# VSCode
#//////////////////////////
.vscode/

#//////////////////////////
# WebStorm
#//////////////////////////
.idea/

# 客户端素材（体积大、不进版本库；删前必备份）
client/assets/resources/

# 例外：#1337 的通用 NPC 对话 prefab 是**代码资产**（要在编辑器里可视化改版式），
# 连同它依赖的纯色图一起入库；其余素材仍不进仓库
!client/assets/resources/
client/assets/resources/*
!client/assets/resources/ui/
client/assets/resources/ui/*
!client/assets/resources/ui/NpcDialog.prefab
!client/assets/resources/ui/NpcDialog.prefab.meta
!client/assets/resources/ui/npc-solid.png
!client/assets/resources/ui/npc-solid.png.meta

# resources 分发的分卷 zip 产物（make resources-pack 输出；进 GitHub Release，不进仓库）
resources_dist/
# 已图集化的散帧归档（#235：从 assets 移出的原始逐帧素材 + .meta，重新打包或回退时用）
_loose_frames_archive/

# AI 生图工具的默认输出目录（成品图标人工挑选拷进 resources/ 后，中间底图不留仓库）
generated-images/

# 怪物按动作打包的暂存区（stage-monster-action-frames.py 的产物，打包完即可删）
client/tools/_stage_action_atlas/

#//////////////////////////
# macOS 噪声（Finder 元数据 / AppleDouble，不该进版本库）
#//////////////////////////
.DS_Store
._*

#//////////////////////////
# .workbuddy：只提交「记忆」与「技能」，其余（临时备份等）仍忽略
#   - memory/ 项目记忆：长期约定 + 逐日工作日志，跟随版本库走
#   - skills/ 项目技能：从本项目沉淀的做法与踩坑，跟随版本库走
#   - backup/ 等其余内容是本机临时产物，不进版本库
#//////////////////////////
.workbuddy/*
!.workbuddy/memory
!.workbuddy/skills
.backup

#//////////////////////////
# 部署密钥（**绝不进版本库**：deploy.env 是唯一放服务器 IP / 密钥 / 邀请码的地方，
# 仓库只提交模板 deploy.env.example；.pem 是服务器登录私钥）
#//////////////////////////
deploy.env
*.pem
admin/tsconfig.tsbuildinfo

# 散帧归档（~40GB，仅本机留底，永不入库；见 #288）
_loose_frames_archive/

# 本机待办清单（只给自己看，不入库）
/TODO-FOR-USER.md

# 官网截图的原始大图（PNG，单张 2MB+）—— 站点只用压缩后的 jpg，
# 原图留本机备查即可，别把 40MB 截图塞进 PUBLIC 仓库
/_screenshots_src/

#//////////////////////////
# 本地数据库（玩家账号 / 密码哈希 / 角色存档 / 审计日志 / 世界怪物实例）
#   **绝不进版本库**：仓库是 PUBLIC，提交一次 hash 就永久留在 git 历史里。
#   配置同步走 server/data/config-sync.sql（那个文件要提交，不在这里忽略）。
#//////////////////////////
server/data/*.db
server/data/*.db-wal
server/data/*.db-shm
server/data/backups/

# e2e / 本机运行落在 server 根的运行时库（同上，绝不进版本库）
server/*.db
server/*.db-wal
server/*.db-shm

# 真彩地图源素材（~GB 级 .map + WIL/WIX + 缩略图，仅本机留底，转换产物进 client/resources）
/原始地图/
