{
  "name": "olua-server",
  "version": "0.1.0",
  "private": true,
  "description": "olua 游戏服务端（账号 / 角色，含管理端接口）",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prune": "ts-prune -p tsconfig.json --ignore \"generated|node_modules\"",
    "dup": "jscpd src ../admin/src ../client/assets/ui ../client/assets/configs ../tools --min-tokens 120 --reporters consoleFull --silent",
    "start": "node --disable-warning=ExperimentalWarning dist/main.js",
    "dev": "node --disable-warning=ExperimentalWarning -r ts-node/register src/main.ts",
    "test:e2e": "node --disable-warning=ExperimentalWarning test/e2e.cjs",
    "test:e2e:roles": "node --disable-warning=ExperimentalWarning test/e2e-roles.cjs",
    "test:e2e:guard": "node --disable-warning=ExperimentalWarning test/e2e-guard.cjs",
    "test:e2e:backup": "node --disable-warning=ExperimentalWarning test/backup.cjs",
    "test:e2e:mail": "node --disable-warning=ExperimentalWarning test/e2e-mail.cjs",
    "test:e2e:account-email": "node --disable-warning=ExperimentalWarning test/e2e-account-email.cjs",
    "test:e2e:realtime": "node --disable-warning=ExperimentalWarning test/e2e-realtime.cjs",
    "test:e2e:combat": "node --disable-warning=ExperimentalWarning test/e2e-combat.cjs",
    "test:e2e:world": "node --disable-warning=ExperimentalWarning test/e2e-world.cjs",
    "test:e2e:dual": "node --disable-warning=ExperimentalWarning test/e2e-dual.cjs",
    "test:e2e:game-config": "node --disable-warning=ExperimentalWarning test/e2e-game-config.cjs",
    "test:e2e:zone": "node --disable-warning=ExperimentalWarning test/e2e-zone.cjs",
    "db:backup": "node --disable-warning=ExperimentalWarning scripts/backup.cjs",
    "db:restore": "node --disable-warning=ExperimentalWarning scripts/restore.cjs",
    "swagger:emit": "npm run build && node --disable-warning=ExperimentalWarning dist/swagger/emit.js",
    "gen:api": "npm run swagger:emit && node ../tools/gen-api.cjs",
    "verify:api": "npm run swagger:emit && node ../tools/audit-api-generated.cjs",
    "verify": "npm run build && npm run test:e2e && npm run test:e2e:roles && npm run test:e2e:guard && npm run test:e2e:mail && npm run test:e2e:account-email && npm run test:e2e:realtime && npm run test:e2e:combat && npm run test:e2e:world && npm run test:e2e:dual && npm run test:e2e:game-config && npm run test:e2e:backup && npm run test:e2e:zone && npm run test:e2e:guild && npm run test:e2e:social && npm run test:e2e:chat && npm run test:e2e:quest && npm run test:e2e:sell && npm run test:e2e:blocks && npm run test:e2e:party && npm run test:e2e:rank && npm run test:e2e:achievement && npm run test:e2e:game-mail && npm run test:e2e:equip-align && npm run verify:api",
    "test:e2e:guild": "node --disable-warning=ExperimentalWarning test/e2e-guild.cjs",
    "test:e2e:social": "node --disable-warning=ExperimentalWarning test/e2e-social.cjs",
    "test:e2e:chat": "node --disable-warning=ExperimentalWarning test/e2e-chat.cjs",
    "test:e2e:quest": "node --disable-warning=ExperimentalWarning test/e2e-quest.cjs",
    "test:e2e:sell": "node --disable-warning=ExperimentalWarning test/e2e-sell.cjs",
    "test:e2e:blocks": "node --disable-warning=ExperimentalWarning test/e2e-blocks.cjs",
    "test:e2e:party": "node --disable-warning=ExperimentalWarning test/e2e-party.cjs",
    "test:e2e:rank": "node --disable-warning=ExperimentalWarning test/e2e-rank.cjs",
    "test:e2e:achievement": "node --disable-warning=ExperimentalWarning test/e2e-achievement.cjs",
    "test:e2e:game-mail": "node --disable-warning=ExperimentalWarning test/e2e-game-mail.cjs",
    "test:e2e:equip-align": "node --disable-warning=ExperimentalWarning test/e2e-equip-align.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/swagger": "^12.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "nodemailer": "^10.0.16",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/ws": "^8.18.2",
    "jscpd": "^5.4.2",
    "ts-node": "^10.9.2",
    "ts-prune": "^0.10.3",
    "typescript": "~5.9.3"
  }
}
