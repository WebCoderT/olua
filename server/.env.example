# olua 服务端配置（复制为 .env 后按需修改；**代码里不允许再出现这些值的字面量**）

# 监听端口
PORT=3100
# 全局路由前缀（接口最终是 /<API_PREFIX>/xxx；Swagger 固定在 /api-docs）
API_PREFIX=api

# SQLite 数据文件（相对 server/ 目录；填 :memory: 则纯内存、进程退出即丢）
DB_PATH=data/olua.db

# JWT 签名密钥（生产环境必须改成一个随机长串）
JWT_SECRET=olua-dev-secret-please-change-me
# 令牌有效期
JWT_EXPIRES_IN=7d

# 管理端注册码：填写后注册必须带上相同的 registerCode（生产推荐这么做）
# 注意：**留空不再等于开放注册** —— 留空时必须显式设 ADMIN_REGISTER_OPEN=true 才允许注册，
# 否则管理端压根注册不了（首个超管也建不出来）。启动日志与「系统信息」页都会提示这件事。
ADMIN_REGISTER_CODE=olua-admin-2026

# 是否允许玩家自助注册（默认 true）。正式服可以关掉，关掉后只有已注册账号能登录
PLAYER_REGISTER_OPEN=true

# 是否开放管理端自助注册（默认 false）。**只在未配置 ADMIN_REGISTER_CODE 时生效**：
# 配了注册码就以注册码为准。别在公网部署上打开它 —— 任何人都能注册后台，
# 而**第一个**注册的自动是超级管理员
ADMIN_REGISTER_OPEN=false

# 每个账号的角色上限。**只能调低**：不得超过客户端选角界面的站位数量
# （client/assets/configs/layout/scenes.ts 的 roleSelectorLayout.rolePositions），
# 否则玩家能建出界面上没处放的角色（多出来的会叠在原点）。
# 仓库里的默认值由 tools/audit-shared-data.cjs 守着；这一份是部署本地的，守卫看不到。
ROLE_MAX_PER_ACCOUNT=3

# 允许跨域来源，逗号分隔；* = 全部（仅开发用）
CORS_ORIGINS=*

# 运行环境（development / production；只影响标记，不改变行为）
NODE_ENV=development

# 是否打印每个请求的日志（生产可关掉；只打方法/路径/耗时，不打请求体）
LOG_REQUESTS=true

# 是否信任反向代理传来的客户端 IP（X-Forwarded-For）
# 挂在 Nginx / 网关后面**必须**设 true：否则所有请求的来源 IP 都是代理的，
# 登录限流会把全部玩家当成同一个人，一起锁死；直连暴露时**必须**保持 false ——
# 开着等于允许调用方随便伪造 X-Forwarded-For 绕过 IP 限流。
TRUST_PROXY=false

# 登录失败限流：同一用户名连续失败多少次锁定，以及锁定时长（毫秒，默认 10 分钟）
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MS=600000

# 登录失败限流：同一 IP 在锁定时长内失败多少次锁定（防换着用户名扫号）
LOGIN_IP_MAX_FAILURES=20
LOGIN_IP_LOCK_MS=600000

# 操作日志保留条数上限（超出后自动清理最旧的；0 = 不清理）
AUDIT_LOG_MAX_ROWS=20000

# 操作日志保留天数（早于该天数的日志会被清理；0 = 不按时间清理）
# 与上面条数上限是两道独立闸：条数防刷爆磁盘，天数防陈年堆积（一个月只写几百条也会越攒越多）
AUDIT_RETENTION_DAYS=90

# 一次最多导出多少条操作日志（导出接口的上限；超出只给前 N 条并标记 truncated）
AUDIT_EXPORT_MAX_ROWS=5000

# ---------------------------------------------------------------------------
#  邮件通道（不配 = 通道整体禁用：发信接口直接返回「邮件通道未启用」，不会静默丢信）
#
#  三者（主机 / 账号 / 密码）都非空才算配齐；密码属于密钥，只以「已设置 / 未设置」
#  的形态出现在「系统信息」页与启动自检里，从不回显原文。
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=465
# 465 用隐式 TLS（true）；587 走 STARTTLS（false）
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# 发件人地址；留空则回退为 SMTP 账号
SMTP_FROM=

# 发信器实现：smtp（真实投递）/ fake（一律成功）/ fail（一律失败）
# 后两个**只服务于回归测试** —— e2e 是独立进程，只能靠这个环境变量把外部边界换成
# 可替换实现。带着它们上线，邮件要么永远发不出去、要么永远假装成功（启动自检会喊）
MAIL_TRANSPORT=smtp

# 单封邮件最多尝试几次（用尽后标为最终失败并保留原因）
MAIL_MAX_ATTEMPTS=5
# 重试退避基数（毫秒）：第 n 次失败后等待 base * 2^(n-1)，倍数封顶 32 倍
MAIL_RETRY_BASE_MS=60000
# 调度器扫描间隔（毫秒）
MAIL_POLL_MS=15000
# 投递记录保留天数（早于该天数的记录会被自动清理；0 = 不按时间清理）
# 只看「已经发完 / 已经判死」的那些记录：还在队列里等着发的信是任务，删了就是丢信
MAIL_RETENTION_DAYS=90
# 投递记录保留条数上限（超出后清理最旧的；0 = 不清理）
MAIL_QUEUE_MAX_ROWS=20000

# ---------------------------------------------------------------------------
#  自动备份（服务进程自己做，不依赖外部 cron）
#
#  备份用 VACUUM INTO 产出一致性快照，服务正在写也能备；产出后当场做完整性校验，
#  跑完的结果进日志，并露在管理端「系统信息」页的「自动备份」一栏。
# ---------------------------------------------------------------------------
# 多久备份一次（**小时**；0 = 关闭自动备份，那时只能手动 make db-backup）
BACKUP_INTERVAL_HOURS=24
# 备份保留份数（超出后清最旧的；0 = 不按份数清理）
BACKUP_KEEP_COUNT=7
# 备份保留天数（早于该天数的会被清理；0 = 不按时间清理）
BACKUP_RETENTION_DAYS=30
# 备份目录；留空 = 放在数据文件同级的 backups/ 下
# **容器部署别乱改**：数据卷挂在 /app/data，备份写到没挂载的路径上就是容器一重建全丢，
# 而「自动备份在跑」这件事表面上完全看不出异常
BACKUP_DIR=

# ---------------------------------------------------------------------------
#  实时通道（WebSocket，供服务端权威化用）
#
#  握手用的是**一次性票据**而不是访问令牌：先拿令牌调 POST /realtime/ticket 换一张票，
#  再用 ws(s)://<host>/<API_PREFIX>/realtime?ticket=<票> 建连。票据默认 30 秒过期、
#  用过即焚、与账号绑定 —— 所以它出现在 URL 里是安全的（访问令牌则绝不允许）。
# ---------------------------------------------------------------------------
# 票据有效期（毫秒）。只够走完一次「取票 → 握手」；调大会拉长票据被重放的窗口
REALTIME_TICKET_TTL_MS=30000
# 服务端存活探测间隔（毫秒）：每这么久 ping 一次，上一轮没还 pong 的连接直接断开
# （拔网线断掉的连接在 socket 层不会自己消失，没有这道探测就会一直挂在内存里）
REALTIME_HEARTBEAT_MS=30000
# 实时通道是否内嵌主进程（默认 true）。false = 独立进程形态：主进程不挂 WS 通道与
# 取票接口，由 `node dist/main.realtime.js` 单独起实时进程（#37 拆进程的部署形态）
REALTIME_EMBEDDED=true
# 实时进程的监听端口（只有独立进程形态会用到；nginx 把 /api/realtime* 反代到它）
REALTIME_PORT=3101
# 踢下线巡检间隔（毫秒，0 = 关闭）：实时进程轮询库里的在线角色标记，发现连接对应
# 的账号已被清标记（被踢 / 被封）就主动断开（4000）。默认 3 秒内生效
REALTIME_KICK_POLL_MS=3000

# --- 聊天（#395）---
# 单条消息最大长度（字符）；限频 = 窗口内最大条数 / 窗口宽度（毫秒）
CHAT_MAX_LENGTH=120
CHAT_RATE_LIMIT=5
CHAT_RATE_WINDOW_MS=10000

# --- 世界权威（#35）---
# 世界 tick 间隔（毫秒）：检查重生 + 按节流落盘；不做怪物移动（那仍是客户端表现层）
WORLD_TICK_MS=1000
# 世界状态落盘节流（毫秒）：受击/死亡只标脏，tick 按此间隔批量写库；优雅关闭会全量 flush
WORLD_PERSIST_MS=5000
# 怪物死亡后到重生的时间（毫秒）
WORLD_RESPAWN_MS=30000
# 地图实例空闲回收时间（毫秒）：没人看且空闲这么久就从内存卸载（状态在库里）；0 = 不回收
WORLD_MAP_IDLE_MS=600000

# --- 怪物 AI（#323：目标 / 移动 / 普攻权威在服务端）---
# AI tick 间隔（毫秒）：移动积分与普攻判定的节拍（百毫秒级，移动观感）
MONSTER_AI_TICK_MS=100
# AI 广播节流（毫秒）：monster-ai 帧只按此节奏发（位置增量 + 命中事件）
MONSTER_AI_BROADCAST_MS=200
# 位置上报过期时间（毫秒）：超时没上报的玩家视作离场，怪物丢失目标
MONSTER_AI_POS_STALE_MS=3000

# --- 玩家互见（#324：同图玩家位置 / 血量 / 移动标记互见）---
# 互见广播节流（毫秒）：players 帧只按此节奏发（位置增量 + 离开事件）
PLAYER_SYNC_BROADCAST_MS=200
# 外观懒刷新间隔（毫秒，#383）：在场表按此节奏重读在线角色，让「别人换了衣服」最多迟这么久被看到
#（换装走 HTTP 存档，实时进程不会被告知；每帧重读则立刻变成每秒几十次 DB 读）
PLAYER_APPEARANCE_REFRESH_MS=5000

# --- 社交（#388：帮会 / #389：好友与敌人）---
# 帮会人数上限（与帮会等级解耦：等级业务未做，别让它决定真实容量）
GUILD_MEMBER_LIMIT=50
# 好友数量上限（单向计数：只算「已互为好友」，待处理申请不占额度）
SOCIAL_FRIEND_LIMIT=100
# --- 屏蔽与举报（#398）---
# 拉黑名单上限（每人）：只约束「我拉黑了多少人」；被多少人拉黑不设限（否则拉黑会变成可观测信号）
SOCIAL_BLOCK_LIMIT=100
# 屏蔽过滤缓存（毫秒）：聊天与互见按此节奏懒刷新 role_blocks 整表快照；0 = 关缓存（每次现查，仅 e2e 用）
SOCIAL_BLOCK_CACHE_MS=2000

# --- 队伍（#399）---
# 队伍人数上限（默认 4）：小于 2 或非数字一律回落默认
PARTY_MEMBER_LIMIT=4
# 邀请有效期（毫秒，默认 30000）：邀请存内存不落库，过期作废
PARTY_INVITE_TTL_MS=30000
# 队友经验分成比例（默认 0.5，取值 0~1）：队友按自己的等级差算出基数再乘这个比例
PARTY_EXP_MATE_SHARE=0.5
# 组队的最低等级（默认 10）：必须与客户端底部导航「组队」入口的 openLevel 相等
# （tools/audit-shared-data.cjs 会比对）；小于 1 或非数字回落默认
PARTY_MIN_LEVEL=10

# --- 排行榜（#400）---
# 榜单重算周期（毫秒，默认 60000）：榜是物化的，一次重算读全表 + 算战力 + 三个排序；
# 0 = 不起定时器（只有第一次请求时算的那一份快照，仅 e2e 用）
LEADERBOARD_REFRESH_MS=60000
# 上榜条数（默认 100）：既是榜有多长，也是分页 size 的实际上限；「人人都看得到自己」靠 me 接口
LEADERBOARD_TOP_N=100
