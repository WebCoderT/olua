# olua 服务端配置（复制为 .env 后按需修改；**代码里不允许再出现这些值的字面量**）

# 监听端口
PORT=3100
# 全局路由前缀（接口最终是 /<API_PREFIX>/xxx；Swagger 固定在 /api-docs）
API_PREFIX=api

# SQLite 数据文件（相对 server/ 目录；填 :memory: 则纯内存、进程退出即丢）
DB_PATH=data/olua.db

# JWT 签名密钥（生产环境必须改成一个随机长串）
JWT_SECRET=olua-dev-secret-please-change-me
# 令牌有效期
JWT_EXPIRES_IN=7d

# 管理端注册码：留空 = 管理端开放注册；填写后注册必须带上相同的 registerCode
ADMIN_REGISTER_CODE=olua-admin-2026

# 每个账号的角色上限（与客户端 configs/role.maxRoleCount 保持一致）
ROLE_MAX_PER_ACCOUNT=3

# 允许跨域来源，逗号分隔；* = 全部（仅开发用）
CORS_ORIGINS=*

# 运行环境（development / production；只影响标记，不改变行为）
NODE_ENV=development

# 是否打印每个请求的日志（生产可关掉；只打方法/路径/耗时，不打请求体）
LOG_REQUESTS=true
