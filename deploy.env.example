# ==============================================================================
#  部署配置 · 模板（**这个文件提交进仓库**）
#
#  真实配置 = 把它复制成同目录的 `deploy.env`：
#      cp deploy.env.example deploy.env
#
#  `deploy.env` 已在 .gitignore 里，**永远不会、也不允许被提交**。里面放的是：
#    服务器 IP / 登录用户 / 密钥路径 / 管理端邀请码 / JWT 签名密钥
#  这五样一个都不许进版本库 —— 仓库是公开的，进去等于把机器交给陌生人。
#
#  改动的规矩：改字段就改**两份**（模板加注释、真文件填值），别只改一边。
#  完整流程见 docs/deploy.md。
# ==============================================================================

# ---------------------------------------------------------------------------
#  目标机器
# ---------------------------------------------------------------------------
# 服务器公网 IP 或域名
DEPLOY_HOST=请填写服务器公网IP
# SSH 登录用户（腾讯云 Ubuntu 镜像是 ubuntu）
DEPLOY_USER=ubuntu
# SSH 私钥路径；相对仓库根目录，也可以写绝对路径
DEPLOY_KEY=olua.pem
# 服务器上代码存放的目录
DEPLOY_DIR=/opt/olua

# ---------------------------------------------------------------------------
#  对外端口
# ---------------------------------------------------------------------------
# 管理端（含 /api 同源反代）对外监听的宿主机端口
ADMIN_PORT=80
# 游戏客户端（Web 端）对外监听的宿主机端口
GAME_PORT=8080

# ---------------------------------------------------------------------------
#  三站域名（可选，不填用与代码一致的默认值）
# ---------------------------------------------------------------------------
# 写进服务器 compose 目录的 .env，admin 容器的 nginx 模板启动时 envsubst 进配置；
# **换域名只改这里再重发**，不用改代码、不用重建镜像。
# 官网站（空格分隔多个，含 www；分流取第一个做验收）
OLUA_SITE_DOMAINS="yimw.cn www.yimw.cn"
# 管理端（IP 等未匹配访问也进管理端，模板里标 default_server）
OLUA_ADMIN_DOMAIN=admin.yimw.cn
# 游戏站（:8080 直连入口不受它影响）
OLUA_GAME_DOMAIN=game.yimw.cn

# ---------------------------------------------------------------------------
#  服务端密钥（部署时写进服务器上的 server/.env）
# ---------------------------------------------------------------------------
# JWT 签名密钥：必须是随机长串，别用默认值。生成：openssl rand -hex 32
JWT_SECRET=请填写随机长串
# 管理端注册码：注册第一个管理员账号时要填的邀请码
ADMIN_REGISTER_CODE=请填写你的邀请码

# ---------------------------------------------------------------------------
#  HTTPS（#742，可选）
# ---------------------------------------------------------------------------
# on  = 起 TLS 边缘（edge + certbot 两个容器）：:443 持一张四域名证书（上面三个变量里的
#       域名全进 SAN），:80 只保留 ACME 校验 + 301 跳转；对外入口只剩 HTTPS。
# off = 现状：只开 :80，明文（本地开发就是这个，不要改）。
#
# 打开后 deploy.sh 会自动做三件事，不需要你手工改 compose：
#   1. 往服务器上的 compose `.env` 写 `COMPOSE_PROFILES=tls`（edge / certbot 才会被拉起）；
#   2. 把 admin 的宿主机发布口改成 `127.0.0.1:8081` —— 宿主机 :80 只能有一个主人，
#      TLS 下这个主人是 edge；不改就是两个容器抢端口，`up -d` 直接报 port is allocated；
#   3. `up -d` 之后自动跑一次证书续期检查（已签过就什么都不做）。
# **首次签发**要手工跑一次（域名需已解析到本机、控制台放行 443）：
#   bash .workbuddy/skills/olua-deploy/scripts/deploy.sh --tls-init
OLUA_TLS=off
# Let's Encrypt 账号邮箱：证书到期提醒与紧急通知走这里。OLUA_TLS=on 时必填。
OLUA_ACME_EMAIL=

# ---------------------------------------------------------------------------
#  实时分片（可选，#770）
# ---------------------------------------------------------------------------
# 实时进程按「区」分几片。1 = 单进程（默认，什么都不用做）；
# 改成 2 必须同时起第 2 片：docker compose --profile shard-2 up -d
# 改这个值 = 区→片映射变 = 所有在线玩家重连，只在重启窗口里改。
OLUA_REALTIME_SHARDS=1
