# ==============================================================================
#  部署配置 · 模板（**这个文件提交进仓库**）
#
#  真实配置 = 把它复制成同目录的 `deploy.env`：
#      cp deploy.env.example deploy.env
#
#  `deploy.env` 已在 .gitignore 里，**永远不会、也不允许被提交**。里面放的是：
#    服务器 IP / 登录用户 / 密钥路径 / 管理端邀请码 / JWT 签名密钥
#  这五样一个都不许进版本库 —— 仓库是公开的，进去等于把机器交给陌生人。
#
#  改动的规矩：改字段就改**两份**（模板加注释、真文件填值），别只改一边。
#  完整流程见 docs/deploy.md。
# ==============================================================================

# ---------------------------------------------------------------------------
#  目标机器
# ---------------------------------------------------------------------------
# 服务器公网 IP 或域名
DEPLOY_HOST=请填写服务器公网IP
# SSH 登录用户（腾讯云 Ubuntu 镜像是 ubuntu）
DEPLOY_USER=ubuntu
# SSH 私钥路径；相对仓库根目录，也可以写绝对路径
DEPLOY_KEY=olua.pem
# 服务器上代码存放的目录
DEPLOY_DIR=/opt/olua

# ---------------------------------------------------------------------------
#  对外端口
# ---------------------------------------------------------------------------
# 管理端（含 /api 同源反代）对外监听的宿主机端口
ADMIN_PORT=80
# 游戏客户端（Web 端）对外监听的宿主机端口
GAME_PORT=8080

# ---------------------------------------------------------------------------
#  三站域名（可选，不填用与代码一致的默认值）
# ---------------------------------------------------------------------------
# 写进服务器 compose 目录的 .env，admin 容器的 nginx 模板启动时 envsubst 进配置；
# **换域名只改这里再重发**，不用改代码、不用重建镜像。
# 官网站（空格分隔多个，含 www；分流取第一个做验收）
OLUA_SITE_DOMAINS="yimw.cn www.yimw.cn"
# 管理端（IP 等未匹配访问也进管理端，模板里标 default_server）
OLUA_ADMIN_DOMAIN=admin.yimw.cn
# 游戏站（:8080 直连入口不受它影响）
OLUA_GAME_DOMAIN=game.yimw.cn

# ---------------------------------------------------------------------------
#  服务端密钥（部署时写进服务器上的 server/.env）
# ---------------------------------------------------------------------------
# JWT 签名密钥：必须是随机长串，别用默认值。生成：openssl rand -hex 32
JWT_SECRET=请填写随机长串
# 管理端注册码：注册第一个管理员账号时要填的邀请码
ADMIN_REGISTER_CODE=请填写你的邀请码
